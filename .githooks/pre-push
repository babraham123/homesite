#!/usr/bin/env bash
# Checks external links in the site's own pages. Too slow for every commit.
# The synced homelab docs are skipped: their links belong to the homelab repo, and
# they point at example hosts (janedoe.com, private IPs) that never resolve.
# Skip once with: git push --no-verify

set -euo pipefail

command -v lychee > /dev/null || { echo "pre-push: lychee not installed (brew install lychee)" >&2; exit 1; }

lychee --accept 200,429 --no-progress --exclude-path src/www/docs/homelab 'src/www/docs/**/*.md'
